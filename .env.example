# Postgres connection string (Supabase: Project Settings → Database → Connection string → URI)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Supabase (Storage + Postgres). Service role key is server-only — never expose it to the client.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Transcription (OpenAI Whisper) + problem-statement drafting (Anthropic Claude)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Used only by `npm run db:seed` to create the first admin/demo accounts
ADMIN_SEED_EMAIL="admin@inquew.com"
ADMIN_SEED_PASSWORD="change-me"
CLIENT_SEED_PASSWORD="change-me"
