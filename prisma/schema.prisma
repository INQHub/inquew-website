generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Auth (NextAuth / Auth.js) ─────────────────────────

enum Role {
  CLIENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  businessName  String?
  role          Role      @default(CLIENT)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  intakeSessions  IntakeSession[]
  orders          Order[]
  engagementEvent EngagementEvent[]
  auditLogs       AdminAuditLog[]        @relation("AdminActor")
  uploadedFiles   DeliverableFile[]      @relation("UploadedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────── Catalog ─────────────────────────

enum AddonMode {
  NONE
  ADD
  INCLUDED
}

model Deliverable {
  id          String    @id @default(cuid())
  slug        String    @unique
  tier        Int
  title       String
  priceCents  Int
  teaser      String
  description String    @db.Text
  category    String
  keyword     String
  videoAddon  AddonMode @default(NONE)
  zoomAddon   AddonMode @default(NONE)
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  files DeliverableFile[]
  lines OrderLine[]
}

// ───────────────────────── Video intake ─────────────────────────

enum IntakeStatus {
  CONSENT_PENDING
  DECLINED
  RECORDING
  UPLOADING
  TRANSCRIBING
  TRANSCRIBED
  STATEMENT_SELECTED
  COMPLETE
  FAILED
}

model IntakeSession {
  id          String       @id @default(cuid())
  userId      String?
  status      IntakeStatus @default(CONSENT_PENDING)
  consentAt   DateTime?
  declinedAt  DateTime?
  videoKey    String?
  transcript  String?      @db.Text
  errorMessage String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user       User?                 @relation(fields: [userId], references: [id])
  sets       ProblemStatementSet[]
  chosenId   String?
  orders     Order[]

  @@index([userId])
}

model ProblemStatementSet {
  id         String   @id @default(cuid())
  sessionId  String
  source     String   @default("ai") // "ai" | "manual"
  generatedAt DateTime @default(now())

  session    IntakeSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  statements ProblemStatement[]

  @@index([sessionId])
}

model ProblemStatement {
  id       String  @id @default(cuid())
  setId    String
  text     String  @db.Text
  angle    String?
  selected Boolean @default(false)

  set ProblemStatementSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
}

// ───────────────────────── Orders ─────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ASSIGNED
  IN_REVIEW
  AWAITING_CLIENT_REVIEW
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  DASHBOARD
  EMAIL
}

model Order {
  id                    String         @id @default(cuid())
  displayId             String         @unique
  userId                String
  intakeSessionId       String?
  status                OrderStatus    @default(PENDING_PAYMENT)
  progressPct           Int            @default(0)
  deliveryMethod        DeliveryMethod @default(DASHBOARD)
  deliveryEmail         String?
  contactName           String?
  contactEmail          String?
  businessName           String?
  subtotalCents         Int
  stripePaymentIntentId String?
  createdAt             DateTime       @default(now())
  updatedAt              DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  intakeSession IntakeSession? @relation(fields: [intakeSessionId], references: [id])
  lines         OrderLine[]

  @@index([userId])
}

model OrderLine {
  id                String  @id @default(cuid())
  orderId           String
  deliverableId     String
  priceCentsAtOrder Int
  videoAddon        Boolean @default(false)
  zoomAddon         Boolean @default(false)
  editsIncluded     Int     @default(0)
  editsUsed         Int     @default(0)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
  files       DeliverableFile[]

  @@index([orderId])
}

model DeliverableFile {
  id            String   @id @default(cuid())
  orderLineId   String?
  deliverableId String?
  uploadedById  String?
  storageKey    String
  fileName      String
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime @default(now())

  orderLine   OrderLine?   @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
  uploadedBy  User?        @relation("UploadedBy", fields: [uploadedById], references: [id])

  @@index([orderLineId])
}

// ───────────────────────── Engagement / KPI tracking ─────────────────────────

model EngagementEvent {
  id         String   @id @default(cuid())
  type       String
  userId     String?
  anonId     String?
  path       String?
  metadata   Json?
  synthetic  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([createdAt])
  @@index([anonId])
}

model TestResultImport {
  id         String   @id @default(cuid())
  fileName   String
  format     String // "csv" | "json"
  rowCount   Int
  rows       Json
  summary    Json?
  importedAt DateTime @default(now())
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation("AdminActor", fields: [adminId], references: [id])

  @@index([targetType, targetId])
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  message     String   @db.Text
  skipIntake  Boolean  @default(false)
  createdAt   DateTime @default(now())
}
